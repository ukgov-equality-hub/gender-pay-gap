@using GenderPayGap.Core
@using GenderPayGap.Core.Helpers
@using GenderPayGap.Database
@using GenderPayGap.WebUI.Helpers
@using GenderPayGap.WebUI.Models.Scope
@using GovUkDesignSystemDotNet
@model GenderPayGap.WebUI.Models.Scope.ConfirmSectorForYearViewModel

@{
    string encryptedOrganisationId = Encryption.EncryptId(Model.Organisation.OrganisationId);
    string formattedReportingYears = ReportingYearsHelper.FormatYearAsReportingPeriod(Model.ReportingYear);
    ViewBag.Title = $"Choose a sector for your organisation - Gender pay gap service";
    List<OrganisationSicCode> organisationSicCodes = Model.Organisation.OrganisationSicCodes.Where(osc => !osc.IsRetired()).ToList();
}

@section BeforeMain {
    @await Html.GovUkBreadcrumbs(new BreadcrumbsViewModel
    {
        Crumbs = [
            new()
            {
                HtmlOrText = new("Manage Employers"),
                Href = Url.Action("ManageOrganisationsGet", "ManageOrganisations")
            },
            new()
            {
                HtmlOrText = new(Model.Organisation.OrganisationName),
                Href = Url.Action("ManageOrganisationGet", "ManageOrganisations", new {encryptedOrganisationId})
            },
            new()
            {
                HtmlOrText = new($"Reporting year {formattedReportingYears}")
            },
            new()
            {
                HtmlOrText = new($"Choose a sector")
            }
        ]
    })
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @(await Html.GovUkErrorSummaryIfNeeded())

        <h1 class="govuk-heading-xl govuk-!-margin-bottom-2">
            Choose a sector
            <br>
            <span class="govuk-!-font-size-27 govuk-!-margin-top-3" style="display: inline-block; line-height: 1.3 !important;">
                for @(Model.Organisation.OrganisationName)
                <br>
                for reporting year @(formattedReportingYears)
            </span>
        </h1>

        <details class="govuk-details govuk-!-margin-top-4"
                 data-module="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    Why are we asking for a sector?
                </span>
            </summary>
            <div class="govuk-details__text">
                People like to find other organisations like their own, to compare GPGs and see what actions they have chosen.
                <br/>
                <br/>
                We need to know what sector every organisation is in so we can show people the right information.
            </div>
        </details>
        
        <p class="govuk-body">
            Based on the information we hold about @(Model.Organisation.OrganisationName), we have proposed a sector
        </p>

        <dl class="govuk-summary-list">
            @if (Model.Organisation.GetSicCodes().Any())
            {
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">
                        SIC @(organisationSicCodes.Count == 1 ? "code" : "codes") from
                        <br/>
                        Companies House
                        <br/>
                        <a href="https://www.gov.uk/government/publications/standard-industrial-classification-of-economic-activities-sic"
                           target="_blank"
                           class="govuk-link govuk-!-font-size-16 govuk-!-font-weight-regular">
                            Read more
                            <span class="govuk-visually-hidden">about Standard Industrial Classification (SIC) codes</span>
                        </a>
                    </dt>
                    <dd class="govuk-summary-list__value">
                        <ul class="govuk-list">
                            @foreach (OrganisationSicCode organisationSicCode in organisationSicCodes)
                            {
                                <li>
                                    <b>@(organisationSicCode.SicCode.SicCodeId)</b>
                                    @(organisationSicCode.SicCode.Description)
                                    <br/>
                                    <span class="govuk-body-s">
                                        part of: @(organisationSicCode.SicCode.SicSection.Description)
                                    </span>
                                </li>
                            }
                        </ul>
                    </dd>
                </div>
            }
            <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">
                    Proposed sector
                </dt>
                <dd class="govuk-summary-list__value">
                    <b>
                        @(SectorHelper.SectorDefinitions[Model.Sector.Value].Name)
                    </b>
                    <br/>
                    @(SectorHelper.SectorDefinitions[Model.Sector.Value].Description)
                    <br/>
                    <b>Includes:</b>
                    @(SectorHelper.SectorDefinitions[Model.Sector.Value].Includes)
                </dd>
            </div>
        </dl>

        <form method="post"
              action="@Url.Action("ConfirmSectorForYearPost", "Scope", new {encryptedOrganisationId, reportingYear = Model.ReportingYear})">
            @(Html.AntiForgeryToken())
            
            @await Html.GovUkRadiosFor(
                m => m.ConfirmYesNo,
                new RadiosViewModel
                {
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Are you happy with the proposed sector?"),
                            Classes = ["govuk-fieldset__legend--m"]
                        },
                    },
                    Hint = new()
                    {
                        HtmlOrText = new("Hint?"),
                        Classes = ["govuk-!-margin-bottom-3"]
                    }
                },
                new Dictionary<ConfirmSectorForYearYesNoEnum, RadioItemViewModel>
                {
                    {
                        ConfirmSectorForYearYesNoEnum.Yes, new()
                        {
                            Label = new() { HtmlOrText = new("Yeh that's good enough") },
                        }
                    },
                    {
                        ConfirmSectorForYearYesNoEnum.No, new()
                        {
                            Label = new() {HtmlOrText = new("Ooh I'm not sure, show me all of them so I can choose")},
                        }
                    },
                }
            )

            @(await Html.GovUkButton(new ButtonViewModel
            {
                HtmlOrText = new("Save and continue"),
                Classes = ["govuk-!-margin-bottom-3"],
                PreventDoubleClick = true
            }))

            <p class="govuk-body">
                <a class="govuk-link" href="@Url.Action("ManageOrganisationGet", "ManageOrganisations", new {encryptedOrganisationId})">
                    Return to @(Model.Organisation.OrganisationName)
                </a>
            </p>
            
        </form>
        
    </div>
</div>
