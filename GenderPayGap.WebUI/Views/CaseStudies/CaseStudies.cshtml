@using GenderPayGap.Core
@using GenderPayGap.WebUI.Helpers
@using GenderPayGap.WebUI.Models.CaseStudies
@using GovUkDesignSystemDotNet
@model GenderPayGap.WebUI.Models.CaseStudies.CaseStudiesViewModel

@{
    ViewBag.Title = "Case studies";
    
    Dictionary<string, string> categories = new()
    {
        {"menopause", "Menopause"},
        {"gender-pay-gap", "Gender pay gap"},
    };
}

@section BeforeMain {
    @await Html.GovUkBreadcrumbs(new()
    {
        Crumbs = [
            new()
            {
                HtmlOrText = new("Homepage"),
                Href = Url.Action("Index", "Homepage")
            },
            new()
            {
                HtmlOrText = new("Case studies"),
            }
        ]
    })
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">
            Case studies
        </h1>
        <p class="govuk-body">
            Case studies are real world examples of how employers have implemented actions to address their gender pay gap.
        </p>
        <p class="govuk-body">
            These case studies are shared by employers to demonstrate best practice, show what employers can achieve and help other employers to understand what actions their peers are taking.
        </p>
        <div class="govuk-inset-text">
            You can also see a full list of suggested actions for employers to address their gender pay gap.
        </div>
        <p class="govuk-body">
            Case studies are grouped under actions designed to address employers' Gender Pay Gap or to address Menopause
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>
                <a href="#gender-pay-gap"
                   class="govuk-link govuk-link--no-visited-state">
                    Gender pay gap
                </a>
            </li>
            <li>
                <a href="#menopause"
                   class="govuk-link govuk-link--no-visited-state">
                    Menopause
                </a>
            </li>
        </ul>
        
    </div>
</div>

<div class="govuk-grid-row govuk-!-margin-top-9">
    <div id="filter-panel"
         class="govuk-grid-column-one-third-from-desktop"
         style="position: sticky; top: 20px; max-height: 100vh; display: none;">
        
        <h2 class="govuk-heading-m">
            Filter results
        </h2>
        <p class="govuk-body govuk-!-margin-bottom-1">
            Filter results relevant to you:
        </p>
        <div id="filter-summary-hint"
             class="govuk-hint govuk-!-font-size-16">
        </div>
        @await Html.GovUkButton(new()
        {
            Id = "clear-filters-button",
            HtmlOrText = new("Clear all filters"),
            Classes = ["govuk-button--secondary"],
            Attributes = new() {{"style", "width: fit-content;"}}
        })

        <details class="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    Category
                </span>
            </summary>
            <div class="govuk-details__text">
                @await Html.GovUkCheckboxes(new()
                {
                    Name = "category",
                    Classes = ["govuk-checkboxes--small"],
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Category"),
                            Classes = ["govuk-visually-hidden"],
                        },
                    },
                    CheckboxItems = categories.Select(catKvp => new CheckboxItemViewModel
                    {
                        Value = catKvp.Key,
                        Label = new() { HtmlOrText = new(catKvp.Value) },
                        Hint = new() { HtmlOrText = new("2 case studies"), Classes = ["govuk-!-font-size-16"] },
                    }).ToList(),
                })
            </div>
        </details>

        <details class="govuk-details">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    Sector
                </span>
            </summary>
            <div class="govuk-details__text">
                @await Html.GovUkCheckboxes(new()
                {
                    Name = "sector",
                    Classes = ["govuk-checkboxes--small"],
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Sector"),
                            Classes = ["govuk-visually-hidden"],
                        },
                    },
                    CheckboxItems = SectorHelper.SectorDefinitions.Select(
                        sdKvp => new CheckboxItemViewModel
                        {
                            Value = sdKvp.Key.ToString(),
                            Label = new() { HtmlOrText = new(sdKvp.Value.Name)},
                            Hint = new() { HtmlOrText = new("2 case studies"), Classes = ["govuk-!-font-size-16"] },
                        }
                    ).ToList(),
                })
            </div>
        </details>

        <details class="govuk-details govuk-!-margin-bottom-9">
            <summary class="govuk-details__summary">
                <span class="govuk-details__summary-text">
                    Number of employees
                </span>
            </summary>
            <div class="govuk-details__text">
                @await Html.GovUkCheckboxes(new()
                {
                    Name = "number-of-employees",
                    Classes = ["govuk-checkboxes--small"],
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Number of employees"),
                            Classes = ["govuk-visually-hidden"],
                        },
                    },
                    CheckboxItems = Enum.GetValues<OrganisationSizes>()
                        .Except([OrganisationSizes.NotProvided])
                        .Select(e => new CheckboxItemViewModel
                        {
                            Value = e.GetDisplayNameKebabCase(),
                            Label = new() { HtmlOrText = new(e.GetDisplayName()) },
                            Hint = new() { HtmlOrText = new("2 case studies"), Classes = ["govuk-!-font-size-16"] },
                        }).ToList(),
                })
            </div>
        </details>
        
    </div>
    <div id="results-panel"
         class="govuk-grid-column-two-thirds-from-desktop">
        
        @foreach (var categoryKvp in categories)
        {
            <section id="section-@(categoryKvp.Key)"
                     class="govuk-!-margin-bottom-9">
                
                <h2 id="@(categoryKvp.Key)"
                    class="govuk-heading-l">
                    @(categoryKvp.Value)
                </h2>

                <ul class="govuk-list">
                    @foreach (CaseStudyViewModel caseStudyViewModel in Model.CaseStudies.Where(cs => cs.ActionCategory == categoryKvp.Key))
                    {
                        <li data-filter
                             data-filter-category="@(caseStudyViewModel.ActionCategory)"
                             data-filter-size="@(caseStudyViewModel.NumberOfEmployees)"
                             data-filter-sector="@(caseStudyViewModel.Sector.ToString())">
                            <p class="govuk-body-l govuk-!-margin-bottom-2">
                                <a href="@(Url.Action("CaseStudy", "CaseStudies", new {caseStudyId = caseStudyViewModel.Slug}))"
                                   class="govuk-link">
                                    <b>
                                        @(caseStudyViewModel.Employer):
                                    </b>
                                    @(caseStudyViewModel.Title)
                                </a>
                            </p>
                            <p class="govuk-body govuk-!-margin-bottom-2">
                                @(caseStudyViewModel.ShortSummary)
                            </p>

                            <dl class="govuk-summary-list" style="width: unset;">
                                <div class="govuk-visually-hidden">
                                    <dt>
                                        Employer
                                    </dt>
                                    <dd>
                                        @(caseStudyViewModel.Employer)
                                    </dd>
                                </div>
                                <div class="govuk-summary-list__row" style="border: none;">
                                    <dt class="govuk-summary-list__key">
                                        Employees
                                    </dt>
                                    <dd class="govuk-summary-list__value">
                                        @(caseStudyViewModel.NumberOfEmployeesParsed.GetDisplayName())
                                    </dd>
                                </div>
                                <div class="govuk-summary-list__row" style="border: none;">
                                    <dt class="govuk-summary-list__key">
                                        Sector
                                    </dt>
                                    <dd class="govuk-summary-list__value">
                                        @(SectorHelper.SectorDefinitions[caseStudyViewModel.Sector].Name)
                                    </dd>
                                </div>
                            </dl>

                            <hr class="govuk-section-break govuk-section-break--m govuk-section-break--visible govuk-!-margin-top-0">
                        </li>
                    }
                </ul>
            </section>
        }

    </div>
</div>

<script>
    (function () {
        const categoryCheckboxes = document.querySelectorAll('input[name="category"]');
        const sectorCheckboxes = document.querySelectorAll('input[name="sector"]');
        const sizeCheckboxes = document.querySelectorAll('input[name="number-of-employees"]');
        const allCheckboxes = [...categoryCheckboxes, ...sectorCheckboxes, ...sizeCheckboxes];
        const allFilterElements = Array.from(document.querySelectorAll('[data-filter]'));
        const filterPanel = document.getElementById('filter-panel');
        const resultsPanel = document.getElementById('results-panel');
        const detailsExpanders = document.querySelectorAll('details');
        
        function getSelectedValues(checkboxes) {
            return Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.value);
        }
        
        function updateFilterPanelStickyBehavior() {
            const isDesktop = window.matchMedia('(min-width: 48.0625em)').matches;
            const isResultsPanelTaller = resultsPanel.offsetHeight > filterPanel.offsetHeight;
            filterPanel.style.position = isDesktop && isResultsPanelTaller ? 'sticky' : 'static';
            filterPanel.style.maxHeight = isDesktop && isResultsPanelTaller ? '100vh' : 'unset';
        }
        detailsExpanders.forEach(de => de.addEventListener('toggle', updateFilterPanelStickyBehavior));
        window.addEventListener('resize', updateFilterPanelStickyBehavior);

        function applyFilters() {
            const selectedCategories = getSelectedValues(categoryCheckboxes);
            const selectedSectors = getSelectedValues(sectorCheckboxes);
            const selectedSizes = getSelectedValues(sizeCheckboxes);
            
            const categoryMatches = (element) => selectedCategories.length === 0 || selectedCategories.includes(element.getAttribute('data-filter-category'));
            const sectorMatches = (element) => selectedSectors.length === 0 || selectedSectors.includes(element.getAttribute('data-filter-sector'));
            const sizeMatches = (element) => selectedSizes.length === 0 || selectedSizes.includes(element.getAttribute('data-filter-size'));

            allFilterElements.forEach(element => {
                const elementMatches = categoryMatches(element) && sectorMatches(element) && sizeMatches(element);
                element.style.display = elementMatches ? 'block' : 'none';
            });

            const matchingElements = allFilterElements.filter(el => categoryMatches(el) && sectorMatches(el) && sizeMatches(el));
            document.getElementById('filter-summary-hint').innerText = `Showing ${(matchingElements.length)} of ${allFilterElements.length} case studies`;

            const anyMenopauseMatches = matchingElements.filter(el => el.getAttribute('data-filter-category') === 'menopause').length > 0;
            document.getElementById('section-menopause').style.display = anyMenopauseMatches ? 'block' : 'none';
            const anyGenderPayGapMatches = matchingElements.filter(el => el.getAttribute('data-filter-category') === 'gender-pay-gap').length > 0;
            document.getElementById('section-gender-pay-gap').style.display = anyGenderPayGapMatches ? 'block' : 'none';

            const anyFiltersActive = selectedCategories.length > 0 || selectedSectors.length > 0 || selectedSizes.length > 0;

            function updateCheckboxHintAndDisabled(cb, matchIfChecked, matchInTotal) {
                document.getElementById(`${cb.id}-item-hint`).innerText = anyFiltersActive
                    ? `${matchIfChecked} of ${matchInTotal} case studies match`
                    : `${matchInTotal} case ${matchInTotal === 1 ? 'study' : 'studies'}`;
                cb.disabled = matchIfChecked === 0;
            }

            categoryCheckboxes.forEach(cb => {
                const matchIfChecked = allFilterElements.filter(el => el.getAttribute('data-filter-category') === cb.value && sectorMatches(el) && sizeMatches(el)).length;
                const matchInTotal = allFilterElements.filter(el => el.getAttribute('data-filter-category') === cb.value).length;
                updateCheckboxHintAndDisabled(cb, matchIfChecked, matchInTotal);
            });
            sectorCheckboxes.forEach(cb => {
                const matchIfChecked = allFilterElements.filter(el => el.getAttribute('data-filter-sector') === cb.value && categoryMatches(el) && sizeMatches(el)).length;
                const matchInTotal = allFilterElements.filter(el => el.getAttribute('data-filter-sector') === cb.value).length;
                updateCheckboxHintAndDisabled(cb, matchIfChecked, matchInTotal);
            });
            sizeCheckboxes.forEach(cb => {
                const matchIfChecked = allFilterElements.filter(el => el.getAttribute('data-filter-size') === cb.value && categoryMatches(el) && sectorMatches(el)).length;
                const matchInTotal = allFilterElements.filter(el => el.getAttribute('data-filter-size') === cb.value).length;
                updateCheckboxHintAndDisabled(cb, matchIfChecked, matchInTotal);
            });

            updateFilterPanelStickyBehavior();
        }

        allCheckboxes.forEach(cb => cb.addEventListener('change', applyFilters));
        
        document.getElementById('clear-filters-button').addEventListener('click', () => {
            allCheckboxes.forEach(cb => cb.checked = false);
            applyFilters();
        })

        applyFilters();

        function checkStickyState() {
            const isStuck = filterPanel.getBoundingClientRect().top <= 20;
            
            if (isStuck) {
                filterPanel.style.overflowY = 'scroll';
            }
            else {
                if (filterPanel.scrollTop > 0) {
                    filterPanel.scrollTo(0, 0);
                }
                filterPanel.style.overflowY = 'unset';
            }
        }

        let ticking = false;
        window.addEventListener('scroll', function() {
            if (!ticking) {
                window.requestAnimationFrame(() => {
                    checkStickyState();
                    ticking = false;
                });
                ticking = true;
            }
        });
        
        document.getElementById('filter-panel').style.display = 'block';
    })();
</script>