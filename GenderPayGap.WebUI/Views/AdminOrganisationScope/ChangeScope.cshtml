@using GenderPayGap.Core
@using GenderPayGap.Core.Helpers
@using GenderPayGap.WebUI.Helpers
@using GovUkDesignSystemDotNet
@model GenderPayGap.WebUI.Models.Admin.AdminChangeScopeViewModel

@{
    ViewBag.Title = "Change scope - Administration - Gender pay gap service";
    string formattedReportingYears = ReportingYearsHelper.FormatYearAsReportingPeriod(Model.ReportingYear);
}

@section BeforeMain {
    @await Html.GovUkBreadcrumbs(new()
    {
        Crumbs = [
            new()
            {
                HtmlOrText = new("Admin"),
                Href = Url.Action("AdminHomePage", "AdminHomepage")
            },
            new()
            {
                HtmlOrText = new(Model.OrganisationName),
                Href = Url.Action("ViewOrganisation", "AdminViewOrganisation", new {id = Model.OrganisationId})
            },
            new()
            {
                HtmlOrText = new("Scope history"),
                Href = Url.Action("ViewScopeHistory", "AdminOrganisationScope", new {id = Model.OrganisationId})
            },
            new()
            {
                HtmlOrText = new("Change scope")
            }
        ]
    })
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        <span class="govuk-caption-xl">Administration</span>
        <h1 class="govuk-heading-xl">
            Change scope
            <br />
            <span class="govuk-!-font-size-27">
                for @(Model.OrganisationName)
                <br>
                for reporting year @(formattedReportingYears)
            </span>
        </h1>

        <form method="POST" action="@Url.Action("ChangeScopeForYearPost", "AdminOrganisationScope", new { id = Model.OrganisationId, year = Model.ReportingYear })">
            @(Html.AntiForgeryToken())

            @(await Html.GovUkErrorSummaryIfNeeded())

            @await Html.GovUkRadiosFor(
                m => m.ScopeStatus,
                new()
                {
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("New scope"),
                            Classes = ["govuk-fieldset__legend--m"]
                        },
                    }
                }
            )
            
            @await Html.GovUkRadios(new()
            {
                Name = Html.NameFor(m => m.ReadGuidance),
                Fieldset = new()
                {
                    Legend = new()
                    {
                        HtmlOrText = new("Has the user read the guidance?"),
                        Classes = ["govuk-fieldset__legend--m"]
                    }
                },
                RadioItems = [
                    new()
                    {
                        Value = "True",
                        Label = new() { HtmlOrText = new("Yes")},
                        Checked = Model.ReadGuidance == true
                    },
                    new()
                    {
                        Value = "False",
                        Label = new() { HtmlOrText = new("No")},
                        Checked = Model.ReadGuidance == false
                    },
                    new()
                    {
                        Value = "",
                        Label = new() { HtmlOrText = new("Unset")},
                        Checked = Model.ReadGuidance == null
                    },
                ]
            })
            
            @await Html.GovUkTextInputFor(
                m => m.StatusDetails,
                new()
                {
                    Label = new()
                    {
                        HtmlOrText = new("Status details"),
                        Classes = ["govuk-label--m"]
                    }
                }
            )
            
            <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

            @await Html.GovUkRadios(new()
                {
                    Name = Html.NameFor(m => m.Sector),
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Sector"),
                            Classes = ["govuk-fieldset__legend--m"]
                        }
                    },
                    RadioItems = SectorHelper.SectorDefinitions.Select(
                        sdKvp => new RadioItemViewModel
                        {
                            Value = sdKvp.Key.ToString(),
                            Checked = Model.Sector == sdKvp.Key,
                            Label = new() { HtmlOrText = new(sdKvp.Value.Name)}
                        }
                    ).ToList()
                }
            )

            @await Html.GovUkRadiosFor(
                m => m.SectorStatus,
                new()
                {
                    Fieldset = new()
                    {
                        Legend = new()
                        {
                            HtmlOrText = new("Sector status"),
                            Classes = ["govuk-fieldset__legend--m"]
                        },
                    }
                }
            )

            <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

            @await Html.GovUkTextInputFor(
                m => m.NumberOfEmployees,
                new()
                {
                    Label = new()
                    {
                        HtmlOrText = new("Number of employees"),
                        Classes = ["govuk-label--width-10"]
                    }
                }
            )

            @await Html.GovUkCheckboxItemFor(
                m => m.NumberOfEmployeesSkipped,
                new()
                {
                    Label = new()
                    {
                        HtmlOrText = new("Number of employees question skipped"),
                    }
                }
            )

            <hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

            @await Html.GovUkCharacterCountFor(
                m => m.Reason,
                new()
                {
                    Label = new()
                    {
                        HtmlOrText = new("What is the reason for this change?"),
                        Classes = ["govuk-label--m"]
                    },
                }
            )
            
            @(await Html.GovUkButton(new()
            {
                HtmlOrText = new("Confirm"),
                Classes = ["govuk-!-margin-bottom-4"],
                PreventDoubleClick = true
            }))

            <p class="govuk-body">
                <a href="@Url.Action("ViewOrganisation", "AdminViewOrganisation", new {id = Model.OrganisationId})"
                   class="govuk-link">
                    Cancel and return to organisation page
                </a>
            </p>
        </form>
        
    </div>
</div>
